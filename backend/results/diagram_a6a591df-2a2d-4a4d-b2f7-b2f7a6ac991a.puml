@startuml
!include <c4/C4_Container>

LAYOUT_TOP_DOWN()
skinparam dpi 300

Person(person, "User", "LADEVM")

Container_Boundary(c, "Automation Interfaces Tools") {
    Container(Produce, "Produce.bat Generation", "Script", "Trigger generation of Produce.bat.")
    Container(Check, "Check.bat Generation", "Script", "Trigger generation of Check.bat.")
    Container(PVER, "PVER Object", "Data Class", "Manages PVER data structure and operations.")
    Container(jinja2, "Jinja2", "Template Engine", "Maps patterns and facilitates templating.")
}

person --> Produce: default
person --> Check: --mode Check
Produce --> PVER: Uses to create configuration objects
Check --> PVER: Uses to create configuration objects
PVER --> jinja2: Utilizes for pattern mapping

SHOW_LEGEND()
@enduml