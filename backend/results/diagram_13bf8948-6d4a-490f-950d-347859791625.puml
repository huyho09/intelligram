@startuml
skinparam linetype ortho
top to bottom direction

start

:User opens the login page;
:User enters username and password;

if (Input not empty?) then (yes)
    if (Username exists in database?) then (yes)
        if (Password correct?) then (yes)
            if (2FA enabled?) then (yes)
                :Send OTP to user;
                :Wait for OTP input;
                if (OTP correct?) then (yes)
                    :Generate session token;
                    :Redirect to dashboard;
                else (no)
                    :Show "Incorrect OTP" error;
                    :Retry OTP input;
                endif
            else (no)
                :Generate session token;
                :Redirect to dashboard;
            endif
        else (no)
            :Show "Incorrect password" error;
            :Return to login page;
        endif
    else (no)
        :Show "User not found" error;
        :Return to login page;
    endif
else (no)
    :Show "Input cannot be empty" error;
    :Return to login page;
endif

:Store session and allow access to secure pages only if the session is valid;

stop
@enduml