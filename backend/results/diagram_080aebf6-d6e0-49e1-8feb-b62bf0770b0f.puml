@startuml
|User|
start

:Open login page;
:Enter username and password;

|System|
:Validate input (not empty);
if (Input valid?) then (yes)
    :Check if username exists in database;
    if (Username exists?) then (yes)
        :Check password;
        if (Password correct?) then (yes)
            :Check if 2FA is enabled;
            if (2FA enabled?) then (yes)
                :Send OTP to user;
                :Wait for OTP input;
                if (OTP correct?) then (yes)
                    :Generate session token;
                    :Redirect to dashboard;
                else (no)
                    :Show error and retry;
                    stop
                endif
            else (no)
                :Generate session token;
                :Redirect to dashboard;
            endif
        else (no)
            :Show "Incorrect password" error;
            :Return to login;
            stop
        endif
    else (no)
        :Show "User not found" error;
        :Return to login page;
        stop
    endif
else (no)
    :Show input error;
    :Return to login page;
    stop
endif

:Store session;
:Allow access to secure pages only if session is valid;

@enduml