@startuml
skinparam dpi 300
skinparam sequence {
    ActorBackgroundColor blue
    LifeLineBorderColor blue
    LifeLineBackgroundColor blue
    ParticipantBorderColor blue
    ParticipantBackgroundColor blue
    SequenceBoxBackgroundColor blue
    SequenceBoxBorderColor blue
}
autonumber
skinparam linetype ortho

actor Tester
participant ECU
participant "Tester Tool" as TesterTool
participant KMS

Tester -> ECU: Establish diagnostic session
ECU -> Tester: Generate challenge (nonce + auth bits)
Tester -> TesterTool: Pass challenge
TesterTool -> KMS: Check user authorization
alt User authorized
    KMS -> TesterTool: Sign challenge (RSASSA-PSS)
else User not authorized
    KMS -> TesterTool: Access denied
end
TesterTool -> ECU: Provide KMS response
alt Signature correct
    ECU -> Tester: Grant access
else Signature incorrect
    ECU -> Tester: Access denied
end

@enduml