@startuml
start

:Open the login page;
:Enter username and password;

-> :Validate input (not empty);
-> :Check if username exists in the database;
if (Username found?) then (yes)
  -> :Check password;
  if (Password correct?) then (yes)
    -> :Check if 2FA is enabled;
    if (2FA enabled?) then (yes)
      -> :Send OTP to user;
      :Wait for OTP input;
      if (OTP correct?) then (yes)
        -> :Generate session token;
        :Redirect to dashboard;
      else (no)
        :Show "Incorrect OTP" error;
        :Retry;
      endif
    else (no)
      -> :Generate session token;
      :Redirect to dashboard;
    endif
  else (no)
    :Show "Incorrect password" error;
    :Return to login;
  endif
else (no)
  :Show "User not found" error;
  :Return to login;
endif

:Store session;
:Allow access to secure pages only if session is valid;

stop
@enduml