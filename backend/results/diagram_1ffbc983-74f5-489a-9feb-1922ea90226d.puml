@startuml
skinparam linetype ortho
start
:User opens the login page;
:User enters username and password;

if (Validate input?) then (Valid)
  if (Username exists in database?) then (Yes)
    if (Password correct?) then (Yes)
      if (2FA enabled?) then (Yes)
        :Send OTP to user;
        repeat
          :Wait for OTP input;
          if (OTP correct?) then (Yes)
            :Generate session token;
            :Redirect to dashboard;
            ->loop
          else (No)
            :Show error and retry;
        end repeat (Max tries)
      else (No)
        :Generate session token;
        :Redirect to dashboard;
      endif
    else (No)
      :Show "Incorrect password" error;
      :Return to login;
    endif
  else (No)
    :Show "User not found" error;
    :Return to login page;
  endif
else (Invalid)
  :Return to login page;
endif

:Store session;
:Allow access to secure pages only if session is valid;
stop
@enduml