@startuml
skinparam linetype ortho
left to right direction
autonumber

start
:User opens the login page;
:User enters username and password;
repeat
  :System validates input (not empty);
  repeat
    :System checks if username exists in database;
    if (Username found?) then (yes)
      :Check password;
      if (Password correct?) then (yes)
        if (2FA enabled?) then (yes)
          :Send OTP to user;
          :Wait for OTP input;
          if (OTP correct?) then (yes)
            :Generate session token;
            :Redirect to dashboard;
          else (no)
            :Show "Incorrect OTP" error;
          endif
        else (no)
          :Generate session token;
          :Redirect to dashboard;
        endif
      else (no)
        :Show "Incorrect password" error;
      endif
    else (no)
      :Show "User not found" error;
    endif
repeat while (User wants to retry login?) is (yes)

:Store session;
:Allow access to secure pages;
end
@enduml