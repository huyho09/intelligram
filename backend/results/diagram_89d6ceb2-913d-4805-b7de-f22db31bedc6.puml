@startuml
start

:Open login page;
:Enter username and password;

repeat
  :Validate input (not empty);
  if (Input not valid?) then (yes)
    :Show "Input cannot be empty" error;
    return
  endif
repeat while (Input not valid?)

:Check if username exists in the database;
if (Username exists?) then (yes)
  :Check password;
  if (Password correct?) then (yes)
    :Check if 2FA is enabled;
    if (2FA enabled?) then (yes)
      :Send OTP to user;
      :Wait for OTP input;
      if (OTP correct?) then (yes)
        :Generate session token;
        :Redirect to dashboard;
      else (no)
        :Show "Incorrect OTP" error;
        :Retry OTP input;
      endif
    else (no)
      :Generate session token;
      :Redirect to dashboard;
    endif
  else (no)
    :Show "Incorrect password" error;
    return
  endif
else (no)
  :Show "User not found" error;
  return
endif

:Store session;
if (Session valid?) then (yes)
  :Access to secure pages;
endif

stop
@enduml