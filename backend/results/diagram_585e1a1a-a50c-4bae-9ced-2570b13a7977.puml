@startuml

start

:User opens the login page;
:User enters username and password;

-> Validate inputs;
if (Input not empty?) then (yes)
    -> Check username in DB;
    if (Username exists?) then (yes)
        -> Validate password;
        if (Password correct?) then (yes)
            -> Check 2FA status;
            if (2FA Enabled?) then (yes)
                -> Send OTP to user;
                :Wait for OTP input;
                if (OTP correct?) then (yes)
                    :Generate session token;
                    :Redirect to dashboard;
                else (no)
                    :Show "Incorrect OTP" error;
                    :Retry OTP input;
                    back -> Wait for OTP input;
                endif
            else (no)
                :Generate session token;
                :Redirect to dashboard;
            endif
        else (no)
            :Show "Incorrect password" error;
            back -> User opens the login page;
        endif
    else (no)
        :Show "User not found" error;
        back -> User opens the login page;
    endif
else (no)
    :Show "Input cannot be empty" error;
    back -> User opens the login page;
endif

-> Store session;
:Allow access to secure pages only if session is valid;

stop

@enduml