@startuml
|User|
start
:Open login page;
:Enter username and password;

|System|
:Validate input (not empty);

if (Username exists in the database?) then (no)
  :Show "User not found" error;
  :Return to login page;
  stop
else (yes)
  if (Is password correct?) then (no)
    :Show "Incorrect password" error;
    :Return to login;
    stop
  else (yes)
    if (Is 2FA enabled?) then (yes)
      :Send OTP to user;
      :Wait for OTP input;
      
      if (Is OTP correct?) then (no)
        :Show error and retry;
        :Return to login page;
        stop
      else (yes)
        :Generate session token;
        :Redirect to dashboard;
      endif

    else (no)
      :Generate session token;
      :Redirect to dashboard;
    endif
  endif
endif

:Store session;
:Allow access to secure pages if session is valid;

@enduml