@startuml
skinparam linetype ortho
top to bottom direction

start

:User opens login page;
:User enters username and password;

repeat
  :System validates input (not empty);
repeat while (Empty input?) is (yes)
  :Show "Input cannot be empty" error;
  :Return to login page;
repeat while (Empty input?) is (no)

repeat
  :Check if username exists in database;
repeat while (Username exists?) is (no)
  :Show "User not found" error;
  :Return to login page;
repeat while (Username exists?) is (yes)

repeat
  :Check if password is correct;
repeat while (Password correct?) is (no)
  :Show "Incorrect password" error;
  :Return to login;
repeat while (Password correct?) is (yes)

if (2FA enabled?) then (yes)
  :Send OTP to user;
  repeat
    :Wait for OTP input;
  repeat while (OTP correct?) is (no)
    :Show "Incorrect OTP" error;
    :Retry input;
  repeat while (OTP correct?) is (yes)
    :Generate session token;
    :Redirect to dashboard;
else (no)
  :Generate session token;
  :Redirect to dashboard;
endif

:Store session;
:Allow access to secure pages if session is valid;

end
@enduml