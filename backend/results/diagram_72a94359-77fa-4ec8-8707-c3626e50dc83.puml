@startuml
!include <office/activity>

start

:User opens the login page;
partition "Login Process" {
    :User enters username and password;

    if (Input valid?) then (Yes)
        if (Username exists?) then (Yes)
            :Check password;
            if (Password correct?) then (Yes)
                if (2FA enabled?) then (Yes)
                    :Send OTP to user;
                    fork
                        :Wait for OTP input;
                        if (OTP correct?) then (Yes)
                            :Generate session token;
                            :Redirect to dashboard;
                        else (No)
                            :Show OTP error;
                            repeat
                    end fork
                else (No)
                    :Generate session token;
                    :Redirect to dashboard;
                endif
            else (No)
                :Show "Incorrect password" error;
                :Return to login page;
            endif
        else (No)
            :Show "User not found" error;
            :Return to login page;
        endif
    else (No)
        :Show input validation error;
        :Return to login page;
    endif
}

partition "Session Management" {
    :Store session;
    :Allow access to secure pages if session valid;
}

stop
@enduml