@startuml
skinparam dpi 300
autonumber
skinparam linetype ortho

actor User
participant "Login Page" as LoginPage
participant "Authentication Server" as AuthServer
participant "Database" as DB

User -> LoginPage : Enter username and password
LoginPage -> AuthServer : Send credentials
AuthServer -> DB : Verify credentials
DB --> AuthServer : Return verification status

alt Credentials valid
    AuthServer -> LoginPage : Authentication success
    LoginPage -> User : Access granted
else Credentials invalid
    AuthServer -> LoginPage : Authentication failed
    LoginPage -> User : Access denied
end

@enduml