@startuml
skinparam dpi 300
autonumber
skinparam linetype ortho

actor TesterTool
entity ECU
entity KMS

TesterTool -> ECU: Establish Testing
ECU -> TesterTool: Generate unique challenge (nonce, auth bits)
TesterTool -> KMS: Pass challenge

KMS -> KMS: Check user authorization testing
alt User is authorized
    KMS -> TesterTool: Sign challenge (RSASSA-PSS, RSA2048 with SHA256)
else User is unauthorized
    KMS -> TesterTool: Authorization failed
end

TesterTool -> ECU: Provide KMS response
ECU -> ECU: Verify signature
alt Signature correct
    ECU -> TesterTool: Access granted
else Signature incorrect
    ECU -> TesterTool: Access denied
end

@enduml