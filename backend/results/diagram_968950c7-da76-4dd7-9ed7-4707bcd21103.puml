@startuml
skinparam linetype ortho

start

:Open login page;

repeat
  :Enter username and password;

  if (Input not empty?) then (yes)
    if (Username exists in DB?) then (yes)
      if (Password correct?) then (yes)
        if (2FA enabled?) then (yes)
          :Send OTP to user;
          :Wait for OTP input;
          if (OTP correct?) then (yes)
            :Generate session token;
            :Redirect to dashboard;
          else (no)
            :Show "Incorrect OTP" error;
          endif
        else (no)
          :Generate session token;
          :Redirect to dashboard;
        endif
      else (no)
        :Show "Incorrect password" error;
      endif
    else (no)
      :Show "User not found" error;
    endif
  else (no)
    :Show "Input cannot be empty" error;
  endif

repeat while (Failure?) is (yes)

:Store session;
:Allow access to secure pages;

end
@enduml