@startuml
skinparam linetype ortho
title Secure Web Application User Login Process

start

:User opens the login page;
:User enters username and password;

repeat
  :System validates input (not empty);
  if (Username exists in database?) then (no)
    :Show "User not found" error;
    repeat while (retry?): false
    end repeat
  else (yes)
    :Check password;
    if (Password correct?) then (no)
      :Show "Incorrect password" error;
      repeat while (retry?): false
      end repeat
    else (yes)
      if (2FA enabled?) then (yes)
        :Send OTP to user;
        :Wait for OTP input;
        if (OTP correct?) then (yes)
          :Generate session token;
          :Redirect to dashboard;
          break
        else (no)
          :Show "Incorrect OTP" error;
          repeat while (retry?): false
          end repeat
        endif
      else (no)
        :Generate session token;
        :Redirect to dashboard;
      endif
    endif
  endif
end repeat

:Store session;
:Allow access to secure pages if session is valid;

stop
@enduml